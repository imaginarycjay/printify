{
  "ponytail": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/ponytail-agy-hook.js SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/ponytail-agy-hook.js PreInvocation",
        "timeout": 5
      }
    ]
  }
}
