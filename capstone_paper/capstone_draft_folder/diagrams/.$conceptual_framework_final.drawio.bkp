        <mxCell id="_qh8cepu_KRpxwZSOiqv-1" parent="RW9Po4OWLrbzOsXgOEKc-6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontColor=light-dark(#D3DAEA,#FFFFFF);fontSize=12;" value="&lt;b&gt;Integrated Web-to-Print Platform:&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Role-segregated cloud portals&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer Experience:&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Interactive multi-service order wizards&lt;/span&gt;&lt;br&gt;&lt;span&gt;• Live 5-stage visual progress stepper&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Workshop Floor Hub:&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Digital job tickets &amp;amp; floor Kanban console&lt;/span&gt;&lt;br&gt;&lt;span&gt;• Transparent machine &amp;amp; operator queues&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Automated Inventory Telemetry:&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Automated low-stock &amp;amp; restock alerts&lt;/span&gt;&lt;br&gt;&lt;span&gt;• Real-time stock ledgers &amp;amp; audit trails&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Financial &amp;amp; Operational BI:&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Multi-service sales &amp;amp; revenue dashboards&lt;/span&gt;&lt;br&gt;&lt;span&gt;• Exportable accounting summaries&lt;/span&gt;" vertex="1">
