<mxfile host="Electron" pages="2">
  <diagram name="Figure 1. Conceptual Framework" id="8B79J5k8AkrUeniDQ2U3">
    <mxGraphModel dx="1825" dy="616" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="96tDmhZYpbrEtpMI9iLK-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#0f172a;fontFamily=Helvetica;" value="Figure 1. Conceptual Framework for Integrated Dynamic Order, Job Scheduling, and Inventory Management System" vertex="1">
          <mxGeometry height="30" width="960" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=12;spacingBottom=12;fillColor=default;strokeColor=#0284c7;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0f172a;" value="&lt;b&gt;1. INPUT&lt;/b&gt;&lt;hr style=&#39;margin: 4px 0; border: 0; border-top: 1px solid #94a3b8;&#39;&gt;&lt;b&gt;Stakeholder Profiles:&lt;/b&gt;&lt;br&gt;• Business Owners (Pricing &amp; Config)&lt;br&gt;• Production Staff (Task Allocation)&lt;br&gt;• Customers (Self-Service Ordering)&lt;br&gt;&lt;br&gt;&lt;b&gt;Modular Service Parameters:&lt;/b&gt;&lt;br&gt;• Dynamic Pricing Formulas (Page/SqFt/Unit)&lt;br&gt;• Media Specs (Short, A4, Long; 70-100 gsm)&lt;br&gt;• Substrates (Paper, Vinyl, Garment, PVC)&lt;br&gt;• Finishing Rules (Foil, Ring Bind, Eyelets)&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer Assets &amp; Proofs:&lt;/b&gt;&lt;br&gt;• PDF Manuscripts &amp; Vector Artwork&lt;br&gt;• GCash / Maya Receipts &amp; Cash Proofs&lt;br&gt;&lt;br&gt;&lt;b&gt;Raw Consumables &amp; BOM:&lt;/b&gt;&lt;br&gt;• Paper Reams, Vinyl Rolls, Inks, Boards&lt;br&gt;• Stock Baselines &amp; Safety Buffers" vertex="1">
          <mxGeometry height="420" width="340" x="-250" y="10" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=12;spacingBottom=12;fillColor=#f8fafc;strokeColor=#6366f1;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0f172a;" value="&lt;b&gt;2. PROCESS&lt;/b&gt;&lt;hr style=&#39;margin: 4px 0; border: 0; border-top: 1px solid #94a3b8;&#39;&gt;&lt;b&gt;Order Intake &amp; Dynamic Quotation:&lt;/b&gt;&lt;br&gt;• Instant multi-attribute cost computation&lt;br&gt;• Duplex discounts, rush fees &amp; add-ons&lt;br&gt;• Manual payment verification &amp; routing&lt;br&gt;&lt;br&gt;&lt;b&gt;Workshop Floor Scheduling:&lt;/b&gt;&lt;br&gt;• 5-Stage Kanban Queue Tracking&lt;br&gt;  (Queue → Print → Assembly → QC → Ready)&lt;br&gt;• Customer paper tracking (&#39;Dala ang Papel&#39;)&lt;br&gt;• Machine &amp; operator task assignment&lt;br&gt;&lt;br&gt;&lt;b&gt;Automated Inventory Telemetry:&lt;/b&gt;&lt;br&gt;• Stage-based Bill of Materials (BOM) burn&lt;br&gt;• 7-day &amp; 30-day velocity (Burn Rate) calculation&lt;br&gt;• Dynamic Reorder Point (ROP) evaluation&lt;br&gt;&lt;br&gt;&lt;b&gt;Business Intelligence:&lt;/b&gt;&lt;br&gt;• Sales, product mix &amp; margin aggregation" vertex="1">
          <mxGeometry height="420" width="340" x="340" y="60" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=12;spacingBottom=12;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0f172a;" value="&lt;b&gt;3. OUTPUT&lt;/b&gt;&lt;hr style=&#39;margin: 4px 0; border: 0; border-top: 1px solid #94a3b8;&#39;&gt;&lt;b&gt;Integrated Web-to-Print Platform:&lt;/b&gt;&lt;br&gt;• Role-segregated cloud portals&lt;br&gt;&lt;br&gt;&lt;b&gt;Customer Experience:&lt;/b&gt;&lt;br&gt;• Interactive multi-service order wizards&lt;br&gt;• Live 5-stage visual progress stepper&lt;br&gt;&lt;br&gt;&lt;b&gt;Workshop Floor Hub:&lt;/b&gt;&lt;br&gt;• Digital job tickets &amp; floor Kanban console&lt;br&gt;• Transparent machine &amp; operator queues&lt;br&gt;&lt;br&gt;&lt;b&gt;Automated Inventory Telemetry:&lt;/b&gt;&lt;br&gt;• Automated low-stock &amp; restock alerts&lt;br&gt;• Real-time stock ledgers &amp; audit trails&lt;br&gt;&lt;br&gt;&lt;b&gt;Financial &amp; Operational BI:&lt;/b&gt;&lt;br&gt;• Multi-service sales &amp; revenue dashboards&lt;br&gt;• Exportable accounting summaries" vertex="1">
          <mxGeometry height="420" width="340" x="810" y="80" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0f172a;" value="&lt;b&gt;4. OUTCOME (Immediate Operational Benefits)&lt;/b&gt;&lt;hr style=&#39;margin: 4px 0; border: 0; border-top: 1px solid #94a3b8;&#39;&gt;• &lt;b&gt;Error-Free Multi-Product Intake:&lt;/b&gt; Eliminates manual calculation errors, counter congestion, and pricing discrepancies across services.&lt;br&gt;• &lt;b&gt;Organized Workshop Floor:&lt;/b&gt; Completely eliminates lost paper job tickets, misplaced client files, and production floor mix-ups.&lt;br&gt;• &lt;b&gt;24/7 Client Transparency:&lt;/b&gt; Provides frictionless online order tracking, drastically reducing repeated follow-up calls and visits.&lt;br&gt;• &lt;b&gt;Zero Stockout Halts:&lt;/b&gt; Prevents unexpected supply exhaustion during peak academic rush, election campaigns, and commercial events.&lt;br&gt;• &lt;b&gt;Data-Driven Procurement:&lt;/b&gt; Replaces intuitive inventory guesswork with actual sales burn-rate velocity and automated reorder alerts." vertex="1">
          <mxGeometry height="150" width="840" x="180" y="550" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fillColor=#f0fdf4;strokeColor=#14b8a6;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#0f172a;" value="&lt;b&gt;5. IMPACT (Long-Term Organizational &amp; Academic Contributions)&lt;/b&gt;&lt;hr style=&#39;margin: 4px 0; border: 0; border-top: 1px solid #94a3b8;&#39;&gt;• &lt;b&gt;Enterprise Productivity &amp; Profitability:&lt;/b&gt; Maximizes operational throughput, reduces raw material waste, and boosts profit margins for printing MSMEs.&lt;br&gt;• &lt;b&gt;Heightened Market Trust &amp; Reliability:&lt;/b&gt; Strengthens client confidence through consistent turnaround times and superior service dependability.&lt;br&gt;• &lt;b&gt;Code-Free Business Adaptability:&lt;/b&gt; Empowers printing shop owners to dynamically configure, price, and launch new print products without coding.&lt;br&gt;• &lt;b&gt;Information Systems Benchmark:&lt;/b&gt; Establishes a validated empirical baseline for lightweight job-shop business automation and inventory replenishment." vertex="1">
          <mxGeometry height="140" width="840" x="180" y="750" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-7" edge="1" parent="1" source="96tDmhZYpbrEtpMI9iLK-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#334155;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;fontStyle=1;" target="96tDmhZYpbrEtpMI9iLK-3" value="Feeds Operational Data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-8" edge="1" parent="1" source="96tDmhZYpbrEtpMI9iLK-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#334155;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;fontStyle=1;" target="96tDmhZYpbrEtpMI9iLK-4" value="Generates Functional Deliverables">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-9" edge="1" parent="1" source="96tDmhZYpbrEtpMI9iLK-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#334155;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;fontStyle=1;" target="96tDmhZYpbrEtpMI9iLK-5" value="Delivers Immediate Operational Gains">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="525" />
              <mxPoint x="600" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-10" edge="1" parent="1" source="96tDmhZYpbrEtpMI9iLK-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#334155;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;fontStyle=1;" target="96tDmhZYpbrEtpMI9iLK-6" value="Achieves Long-Term Strategic Goals">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="96tDmhZYpbrEtpMI9iLK-11" edge="1" parent="1" source="96tDmhZYpbrEtpMI9iLK-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284c7;dashed=1;endArrow=classic;endFill=1;fontSize=10;fontColor=#0284c7;fontStyle=1;" target="96tDmhZYpbrEtpMI9iLK-2" value="Continuous System Refinement &amp; Stock Synchronization">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="625" />
              <mxPoint x="120" y="625" />
              <mxPoint x="120" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
